#!/usr/bin/env bash
# Actra coding standard: https://github.com/Actra-AG/coding-standard (standards/tooling.md, section 8)
#
# Deploys the project to its server over SSH: the server checkout switches to a commit that exists on origin, then
# runs composer install, clears the configured directories and runs the configured commands. Live changes on the
# server inside syncPaths are committed there, fetched over SSH, added as one commit on top of the defaultRef branch
# (linear history, no merge commit) and pushed to origin first. Configuration: deploy.json in the project root, with
# optional named targets (servers) that override its top-level keys. Runs on the developer's machine with bash 3.2 or
# newer (macOS default), git 2.38 or newer, ssh and jq; the server needs bash (4.2 or newer, or the date command), git
# and composer.

set -euo pipefail

readonly config_file='deploy.json'
readonly log_file='deploy.log'
readonly config_keys='["after","clearDirectories","defaultRef","host","path","syncPaths"]'
# Names of targets: shown, typed to confirm and passed to --target
readonly target_pattern='^[A-Za-z0-9][A-Za-z0-9._-]*$'
readonly live_ref='refs/deploy/live'

usage() {
  cat <<'USAGE'
Usage: vendor/bin/deploy [--yes] [--target <name>] [<tag|branch|commit>]

Deploys the project to the server configured in deploy.json, or to one of its targets. Without --target, the
defaultTarget of deploy.json is deployed, or its only target. Without a ref, the defaultRef of the target is
deployed. Only commits that exist on origin can be deployed. Roll back with git revert on the defaultRef branch, push
and deploy again; other refs leave the checkout detached until the next deployment of the defaultRef. Live changes on
the server inside syncPaths are committed, added as one commit on top of the defaultRef branch and pushed to origin
first.

Options:
  -t, --target <name>  Deploy to this target of deploy.json
  -y, --yes            Deploy without asking for confirmation
  -h, --help           Show this help
USAGE
}

fail() {
  printf 'deploy: %s\n' "$*" >&2
  exit 1
}

# Quotes a value as one word for the remote shell
quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Validates a glob of clearDirectories or syncPaths: relative to the project root, never leaving it
validate_pattern() {
  local key=$1 pattern=$2 segment
  local -a segments
  # Character classes ([0-9]) allowed, e.g. app/cache/v[0-9]*/ keeps yuf's FileCache in app/cache/values/
  local allowed='^[]A-Za-z0-9._*?/[-]+$'
  [[ $pattern =~ $allowed ]] \
    || fail "$key: \"$pattern\" may only contain letters, digits and . _ - / * ? [ ]"
  [[ $pattern != /* ]] || fail "$key: \"$pattern\" must be relative to the project root"
  IFS=/ read -r -a segments <<< "${pattern%/}"
  [[ ${segments[0]} != *[*?[]* ]] \
    || fail "$key: the first directory of \"$pattern\" must be named without wildcards"
  for segment in "${segments[@]}"; do
    case $segment in
      '' | . | .. | .git) fail "$key: \"$pattern\" must not contain empty, ., .. or .git segments" ;;
    esac
  done
}

# Reads and validates deploy.json and selects the target; sets target, host, path, default_ref, confirm,
# clear_patterns, sync_patterns and after_commands
read_config() {
  local errors name names=''
  local -a target_names=()
  [[ -f $config_file ]] || fail "$config_file not found in the project root (template: templates/deploy.json)"
  errors=$(jq -r --argjson known "$config_keys" --arg name_pattern "$target_pattern" '
    # Errors of a complete configuration (top-level keys, or top-level keys merged with a target)
    def check_values:
      . as $config
      | ("host", "path", "defaultRef" | select(($config[.] | type) != "string") | "\"\(.)\" must be a string"),
        ("clearDirectories", "syncPaths", "after"
          | . as $key
          | select($config | has($key))
          | select(($config[$key] | type) != "array" or ($config[$key] | map(type) | unique - ["string"] != []))
          | "\"\($key)\" must be an array of strings"),
        (select("clearDirectories" | in($config) | not) | "\"clearDirectories\" is missing (use [] for none)");
    . as $config
    | if type != "object" then "the file must contain a JSON object" else
        (keys - $known - ["defaultTarget", "targets"] | .[] | "unknown key \"\(.)\""),
        (select([.. | strings | select(test("[[:cntrl:]]"))] != []) | "values must not contain control characters"),
        if has("targets") | not then
          (select(has("defaultTarget")) | "\"defaultTarget\" needs \"targets\""),
          check_values
        elif (.targets | type) != "object" or .targets == {} then
          "\"targets\" must be an object with at least one target"
        else
          (select(has("defaultTarget"))
            | if (.defaultTarget | type) != "string" then "\"defaultTarget\" must be a string"
              elif .targets | has($config.defaultTarget) | not then "defaultTarget \"\(.defaultTarget)\" is no target"
              else empty end),
          (.targets | to_entries[]
            | . as $target
            | "target \"\(.key)\": " as $prefix
            | if .key | test($name_pattern) | not then
                "target name \"\(.key)\" may only contain letters, digits and . _ -"
              elif (.value | type) != "object" then
                "\($prefix)must be an object"
              else
                (.value | keys - $known - ["confirm"] | .[] | "\($prefix)unknown key \"\(.)\""),
                (select(.value | has("confirm")) | select(.value.confirm != "name")
                  | "\($prefix)\"confirm\" must be \"name\""),
                ($config | del(.targets, .defaultTarget) + $target.value | check_values | "\($prefix)\(.)")
              end)
        end
      end
  ' "$config_file") || fail "$config_file is not valid JSON"
  [[ $errors == '' ]] || fail "invalid $config_file: ${errors//$'\n'/; }"

  while IFS= read -r name; do target_names+=("$name"); done < <(jq -r '.targets // {} | keys_unsorted[]' "$config_file")
  # Every target is validated, so a broken one is found before it is needed
  for name in ${target_names[@]+"${target_names[@]}"}; do
    load_target "$name"
    names+="${names:+, }$name"
  done
  if [[ ${#target_names[@]} == 0 ]]; then
    [[ $target == '' ]] || fail "--target needs \"targets\" in $config_file"
  elif [[ $target == '' ]]; then
    target=$(jq -r '.defaultTarget // empty' "$config_file")
    if [[ $target == '' ]]; then
      [[ ${#target_names[@]} == 1 ]] || fail "choose a target with --target ($names)"
      target=${target_names[0]}
    fi
  else
    for name in "${target_names[@]}"; do
      [[ $name != "$target" ]] || break
    done
    [[ $name == "$target" ]] || fail "unknown target \"$target\" ($names)"
  fi
  load_target "$target"
}

# Reads and validates one target (empty: the top-level keys); sets host, path, default_ref, confirm, clear_patterns,
# sync_patterns and after_commands
load_target() {
  local config line pattern command prefix=''
  [[ $1 == '' ]] || prefix="target \"$1\": "
  # Top-level keys are the defaults of every target
  config=$(jq -c --arg target "$1" \
    'if $target == "" then . else del(.targets, .defaultTarget) + .targets[$target] end' "$config_file")
  host=$(jq -r '.host' <<< "$config")
  path=$(jq -r '.path' <<< "$config")
  default_ref=$(jq -r '.defaultRef' <<< "$config")
  confirm=$(jq -r '.confirm // "yes"' <<< "$config")
  clear_patterns=()
  while IFS= read -r line; do clear_patterns+=("$line"); done < <(jq -r '.clearDirectories[]' <<< "$config")
  sync_patterns=()
  while IFS= read -r line; do sync_patterns+=("$line"); done < <(jq -r '.syncPaths // [] | .[]' <<< "$config")
  after_commands=()
  while IFS= read -r line; do after_commands+=("$line"); done < <(jq -r '.after // [] | .[]' <<< "$config")

  # An SSH alias of ~/.ssh/config: user, port and key belong there, not into the project
  [[ $host =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "${prefix}host must be an SSH alias (letters, digits, . _ -)"
  [[ $path =~ ^/[A-Za-z0-9._@+/-]+$ ]] \
    || fail "${prefix}path must be an absolute path (letters, digits, . _ @ + - /)"
  case "$path/" in
    *//* | */./* | */../*) fail "${prefix}path must not contain empty, . or .. segments" ;;
  esac
  if [[ $default_ref != latest-tag ]] \
    && { [[ $default_ref == -* ]] || ! git check-ref-format "refs/heads/$default_ref"; }; then
    fail "${prefix}defaultRef must be latest-tag or a branch name"
  fi
  for pattern in ${clear_patterns[@]+"${clear_patterns[@]}"}; do
    validate_pattern "${prefix}clearDirectories" "$pattern"
  done
  for pattern in ${sync_patterns[@]+"${sync_patterns[@]}"}; do validate_pattern "${prefix}syncPaths" "$pattern"; done
  # Live changes are committed on top of a branch; a tag cannot take them
  [[ ${#sync_patterns[@]} == 0 || $default_ref != latest-tag ]] \
    || fail "${prefix}syncPaths needs a branch as defaultRef"
  for command in ${after_commands[@]+"${after_commands[@]}"}; do
    [[ $command =~ [^[:space:]] ]] || fail "${prefix}after must not contain empty commands"
  done
}

# Prints the commit of a ref on origin (tags peeled), empty if it does not exist
origin_commit() {
  awk -F '\t' -v ref="$1" '
    $2 == ref "^{}" { peeled = $1 }
    $2 == ref { direct = $1 }
    END { print (peeled != "" ? peeled : direct) }
  ' <<< "$origin_refs"
}

# Prints the highest version tag on origin (vMAJOR.MINOR.PATCH, no pre-releases)
latest_tag() {
  awk -F '\t' '$2 ~ /^refs\/tags\/v?[0-9]+(\.[0-9]+)*$/ { print substr($2, 11) }' <<< "$origin_refs" \
    | awk '{
        version = $0
        sub(/^v/, "", version)
        count = split(version, parts, ".")
        key = ""
        for (i = 1; i <= count; i++) key = key sprintf("%010d.", parts[i])
        print key "\t" $0
      }' \
    | sort -r | awk -F '\t' 'NR == 1 { print $2 }'
}

# Succeeds if the commit is reachable from a branch or tag on origin
on_origin() {
  local commit=$1 ref_commit
  while IFS= read -r ref_commit; do
    git merge-base --is-ancestor "$commit" "$ref_commit" 2> /dev/null && return 0
  done < <(awk -F '\t' '{ print $1 }' <<< "$origin_refs" | sort -u)
  return 1
}

# Resolves the ref to deploy; sets ref_label, target_commit and target_branch (empty: detached checkout)
resolve_ref() {
  local ref=$1 tag_commit branch_commit
  target_branch=''
  if [[ $ref == '' ]]; then
    if [[ $default_ref == latest-tag ]]; then
      ref_label=$(latest_tag)
      [[ $ref_label != '' ]] || fail "origin has no version tag (vMAJOR.MINOR.PATCH)"
      target_commit=$(origin_commit "refs/tags/$ref_label")
    else
      ref_label=$default_ref
      target_commit=$(origin_commit "refs/heads/$default_ref")
      [[ $target_commit != '' ]] || fail "branch $default_ref does not exist on origin"
      target_branch=$default_ref
    fi
    return
  fi
  [[ $ref =~ ^[A-Za-z0-9._/-]+$ && $ref != -* ]] || fail "invalid ref: $ref"
  ref_label=$ref
  tag_commit=$(origin_commit "refs/tags/$ref")
  branch_commit=$(origin_commit "refs/heads/$ref")
  if [[ $tag_commit != '' && $branch_commit != '' ]]; then
    fail "$ref is a tag and a branch on origin; deploy the commit instead"
  fi
  target_commit=$tag_commit$branch_commit
  # The defaultRef branch stays checked out as branch; other branches are temporary, deployed detached
  [[ $branch_commit == '' || $ref != "$default_ref" ]] || target_branch=$ref
  if [[ $target_commit == '' ]]; then
    [[ $ref =~ ^[0-9a-f]{7,40}$ ]] || fail "$ref is no tag or branch on origin and no commit hash"
    target_commit=$(git rev-parse --verify --quiet "$ref^{commit}") || fail "unknown or ambiguous commit: $ref"
    on_origin "$target_commit" || fail "commit $ref is not on origin; push it first"
  fi
}

# Prints how to roll back from the live to the target commit: production stays on the defaultRef branch, so a
# rollback is a revert there and a normal deployment. Nothing when the target is already live.
rollback_hint() {
  local live=$1 target=$2 branch=$default_ref default=$default_ref release='' keep='' range
  if [[ $default_ref == latest-tag ]]; then
    branch='the release branch'
    default='the latest tag'
    release=', tag a new release'
  fi
  # Another ref than the defaultRef was deployed (detached checkout): deploy the defaultRef again
  if [[ $ref != '' && $target_branch == '' ]]; then
    printf '%s (deploys %s; the checkout stays detached until then)' "$deploy_command" "$default"
    return
  fi
  [[ $live != "$target" ]] || return 0
  if git cat-file -e "$live^{commit}" 2> /dev/null && git merge-base --is-ancestor "$live" "$target"; then
    range="$(git rev-parse --short "$live")..$(git rev-parse --short "$target")"
    printf 'git revert --no-edit %s on %s (one commit: git revert <commit>), push%s and run %s' \
      "$range" "$branch" "$release" "$deploy_command"
  else
    # The live commit is unknown or no ancestor (e.g. live changes added on top): revert by hand
    [[ $synced_commit == '' ]] || keep=' (keep the live changes)'
    printf 'revert the unwanted commits on %s%s, push%s and run %s' "$branch" "$keep" "$release" "$deploy_command"
  fi
}

# Prints the short hash of a commit, with its tags
describe() {
  local tags
  if git cat-file -e "$1^{commit}" 2> /dev/null; then
    tags=$(git tag --points-at "$1" | paste -s -d ' ' -)
    printf '%s%s' "$(git rev-parse --short "$1")" "${tags:+ ($tags)}"
  else
    printf '%s (unknown locally)' "$1"
  fi
}

# Prints the commits between the live and the new commit
show_changes() {
  local live=$1 target=$2 count range
  if [[ $live == "$target" ]]; then
    echo 'The commit is already live: deploying it again.'
    return
  fi
  git cat-file -e "$live^{commit}" 2> /dev/null || return 0
  for range in "$live..$target" "$target..$live"; do
    count=$(git rev-list --count "$range")
    [[ $count != 0 ]] || continue
    if [[ $range == "$live..$target" ]]; then echo "New commits ($count):"; else echo "Removed commits ($count):"; fi
    git log --oneline --no-decorate --max-count=30 "$range" | sed 's/^/  /'
    [[ $count -le 30 ]] || echo '  …'
  done
}

# Fetches the live commit from the server checkout over SSH into refs/deploy/live; the server needs no access to
# write to origin
fetch_live() {
  # Login shell: the same PATH as run_remote; git appends the quoted path, which becomes $0
  git fetch --quiet --no-tags --upload-pack="bash -lc 'git upload-pack \"\$0\"'" "$host:$path" "+HEAD:$live_ref" \
    || fail "fetching the live commit from $host failed"
  [[ $(git rev-parse "$live_ref") == "$1" ]] || fail 'the live commit changed since the check; run deploy again'
}

# Succeeds if every live commit missing in the target was picked into it with git cherry-pick -x (by hand after a
# conflict, or by an earlier run whose deployment failed after the push)
live_picked() {
  local target=$1 live=$2 picked commit
  picked=$(git log --format=%B "$target" --not "$live" \
    | sed -n 's/^(cherry picked from commit \([0-9a-f]\{40\}\))$/\1/p')
  while IFS= read -r commit; do
    grep -qxF -- "$commit" <<< "$picked" || return 1
  done < <(git rev-list "$target..$live")
}

# Adds the live changes on top of the target commit without touching the working tree, as a fast-forward or one new
# commit with the live commit's message and author (never a merge commit); prints the resulting commit
add_live() {
  local target=$1 live=$2 output status=0 message commit
  if git merge-base --is-ancestor "$live" "$target" || live_picked "$target" "$live"; then
    printf '%s\n' "$target"
    return
  fi
  if git merge-base --is-ancestor "$target" "$live"; then
    printf '%s\n' "$live"
    return
  fi
  output=$(git merge-tree --write-tree --name-only --no-messages "$target" "$live") || status=$?
  if [[ $status == 1 ]]; then
    printf 'Conflicts:\n%s\n' "$(sed '1d; s/^/  /' <<< "$output")" >&2
    fail "the live changes conflict with $default_ref; nothing deployed. They are committed on the server and" \
      "fetched as $live_ref: pull $default_ref, git cherry-pick -x ..$live_ref, resolve, push and deploy again"
  fi
  [[ $status == 0 ]] || fail 'combining the live changes failed (Git 2.38 or newer is required)'
  # Records the live commits like git cherry-pick -x, so a later run recognises them as synced
  message=$(git show -s --format=%B "$live")$'\n'
  while IFS= read -r commit; do
    message+=$'\n'"(cherry picked from commit $commit)"
  done < <(git rev-list --reverse "$target..$live")
  GIT_AUTHOR_NAME=$(git show -s --format=%an "$live") GIT_AUTHOR_EMAIL=$(git show -s --format=%ae "$live") \
    GIT_AUTHOR_DATE=$(git show -s --format=%ad --date=raw "$live") \
    git commit-tree -p "$target" -F - "$output" <<< "$message"$'\n'
}

# Runs one of the remote_* functions on the server, every argument quoted
run_remote() {
  local function_name=$1 script command argument
  shift
  script="$(declare -f remote_fail remote_check_clean remote_inspect remote_sync remote_write_log remote_deploy)
set -euo pipefail
$function_name \"\$@\""
  # Login shell: the same PATH (composer, PHP version) as an interactive SSH session
  command="bash -lc $(quote "$script") deploy"
  for argument in "$@"; do command+=" $(quote "$argument")"; done
  ssh -n -T -- "$host" "$command"
}

# --- Functions that run on the server ---

remote_fail() {
  printf 'deploy (server): %s\n' "$*" >&2
  exit 1
}

# Fails if the working tree has local changes outside the sync paths (arguments; none: anywhere)
remote_check_clean() {
  if [[ $# == 0 ]]; then
    status=$(git status --porcelain)
  else
    status=$(git status --porcelain --untracked-files=all -- . "${@/#/:(exclude,glob)}")
  fi
  [[ $status == '' ]] && return 0
  printf '%s\n' "$status" >&2
  if [[ $# == 0 ]]; then
    remote_fail 'the working tree on the server has local changes; clean it up first'
  fi
  remote_fail 'the working tree on the server has local changes outside syncPaths; clean it up first'
}

# Arguments: path, sync paths. Prints the live commit, branch and changed files inside the sync paths; fails on other
# local changes
remote_inspect() {
  cd -- "$1" || remote_fail "project root $1 not found"
  shift
  [[ $(git rev-parse --show-toplevel) == "$(pwd -P)" ]] || remote_fail "$(pwd) is not the root of a Git checkout"
  remote_check_clean "$@"
  printf 'deploy-commit=%s\n' "$(git rev-parse HEAD)"
  printf 'deploy-branch=%s\n' "$(git symbolic-ref --short -q HEAD || true)"
  [[ $# == 0 ]] || git status --porcelain --untracked-files=all -- "${@/#/:(glob)}" | sed 's/^/deploy-sync=/'
}

# Arguments: path, expected live commit, user name, user email, sync paths. Commits the live changes inside the sync
# paths and prints the new live commit
remote_sync() {
  cd -- "$1" || remote_fail "project root $1 not found"
  [[ $(git rev-parse HEAD) == "$2" ]] || remote_fail 'the live commit changed since the check; run deploy again'
  export GIT_AUTHOR_NAME=$3 GIT_COMMITTER_NAME=$3 GIT_AUTHOR_EMAIL=$4 GIT_COMMITTER_EMAIL=$4
  shift 4
  remote_check_clean "$@"
  git add -A -- "${@/#/:(glob)}"
  # The changes may have been reverted since the check
  if ! git diff --cached --quiet; then
    git commit --quiet --no-verify -m 'content: sync live changes from the server'
  fi
  printf 'deploy-commit=%s\n' "$(git rev-parse HEAD)"
}

remote_write_log() {
  [[ $deploy_switched == 1 ]] || return 0
  # printf builtin of bash 4.2+, because chroot shells (e.g. Plesk) have no date; date for older bash versions
  deploy_time=$(TZ=UTC0 printf '%(%Y-%m-%dT%H:%M:%SZ)T' -1 2> /dev/null) \
    || deploy_time=$(date -u +%Y-%m-%dT%H:%M:%SZ) || true
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$deploy_time" "$deploy_status" "$deploy_ref" \
    "$(git -C "$deploy_root" rev-parse HEAD)" "$deploy_previous" "$deploy_user" >> "$deploy_root/deploy.log"
}

# Arguments: path, expected live commit, target commit, branch (empty: detached), synced live commit (empty: none), ref,
# user, number of clear patterns, clear patterns, after commands
remote_deploy() {
  cd -- "$1" || remote_fail "project root $1 not found"
  deploy_root=$(pwd -P)
  deploy_previous=$2
  deploy_target=$3
  deploy_branch=$4
  deploy_synced=$5
  deploy_ref=$6
  deploy_user=$7
  deploy_clear=()
  deploy_count=$8
  shift 8
  while [[ $deploy_count -gt 0 ]]; do
    deploy_clear+=("$1")
    shift
    deploy_count=$((deploy_count - 1))
  done
  deploy_switched=0
  deploy_status='failed'

  [[ $(git rev-parse --show-toplevel) == "$deploy_root" ]] \
    || remote_fail "$deploy_root is not the root of a Git checkout"
  git check-ignore -q deploy.log || remote_fail 'deploy.log is not ignored by the project (.gitignore)'
  [[ $(git rev-parse HEAD) == "$deploy_previous" ]] \
    || remote_fail 'the live commit changed since the check; run deploy again'
  [[ $(git status --porcelain) == '' ]] || remote_fail 'the working tree on the server has local changes'
  [[ $deploy_synced == '' || $deploy_synced == "$deploy_previous" ]] \
    || remote_fail 'the synced commit is not the live commit'

  echo '> git fetch --tags --force origin'
  git fetch --tags --force origin
  git cat-file -e "$deploy_target^{commit}" 2> /dev/null \
    || remote_fail "commit $deploy_target not found after fetching origin"

  trap remote_write_log EXIT
  deploy_switched=1
  if [[ $deploy_branch != '' && $deploy_synced != '' \
    && $(git rev-parse -q --verify "refs/heads/$deploy_branch" || true) == "$deploy_synced" ]]; then
    # The live commit was synced as a new commit on top of the branch on origin, so the branch cannot fast-forward.
    # Safe only here: the working tree is clean and the branch is exactly the live commit that was just synced
    echo "> git checkout $deploy_branch && git reset --keep $deploy_target"
    git checkout --quiet "$deploy_branch" --
    git reset --quiet --keep "$deploy_target"
  elif [[ $deploy_branch != '' ]]; then
    echo "> git checkout $deploy_branch && git merge --ff-only $deploy_target"
    git checkout --quiet "$deploy_branch" --
    git merge --quiet --ff-only "$deploy_target"
  else
    echo "> git checkout --detach $deploy_target"
    git -c advice.detachedHead=false checkout --quiet --detach "$deploy_target"
  fi
  [[ $(git rev-parse HEAD) == "$deploy_target" ]] || remote_fail "checkout did not end at $deploy_target"

  echo '> composer install --no-dev --optimize-autoloader --no-interaction'
  composer install --no-dev --optimize-autoloader --no-interaction < /dev/null

  shopt -s nullglob
  for pattern in ${deploy_clear[@]+"${deploy_clear[@]}"}; do
    # Checked again on the server: relative, no . or .. segments
    case "/${pattern%/}/" in
      //* | */./* | */../* | *//*) remote_fail "refusing to clear $pattern" ;;
    esac
    # shellcheck disable=SC2206 # the pattern is a glob, validated to contain no spaces
    matches=($pattern)
    [[ ${#matches[@]} != 0 ]] || echo "> clear $pattern: nothing to clear"
    for match in ${matches[@]+"${matches[@]}"}; do
      match=${match%/}
      parent=$(cd -P -- "$(dirname -- "$match")" && pwd -P)
      name=$(basename -- "$match")
      case "$parent/" in
        "$deploy_root"/*) ;;
        *) remote_fail "refusing to clear $match: outside the project root" ;;
      esac
      echo "> rm -rf $match"
      rm -rf -- "${parent:?}/${name:?}"
    done
  done
  shopt -u nullglob

  for command in "$@"; do
    echo "> $command"
    (cd -- "$deploy_root" && bash -c "$command" < /dev/null)
  done

  deploy_status='ok'
}

# --- Main ---

assume_yes=0
ref=''
target=''
while [[ $# -gt 0 ]]; do
  case $1 in
    -y | --yes) assume_yes=1 ;;
    -t | --target)
      [[ $# -gt 1 && $2 != '' ]] || fail "$1 needs a target name"
      target=$2
      shift
      ;;
    --target=*)
      target=${1#--target=}
      [[ $target != '' ]] || fail '--target needs a target name'
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      [[ $# -le 1 ]] || fail 'only one ref can be deployed'
      ref=${1:-}
      break
      ;;
    -*) fail "unknown option: $1 (see --help)" ;;
    *)
      [[ $ref == '' ]] || fail 'only one ref can be deployed'
      ref=$1
      ;;
  esac
  shift
done

command -v jq > /dev/null || fail 'jq is required (macOS 15 and newer include it, otherwise: brew install jq)'
project_root=$(git rev-parse --show-toplevel 2> /dev/null) || fail 'run deploy inside the project'
cd "$project_root"
git remote get-url origin > /dev/null 2>&1 || fail 'the project has no remote named origin'
[[ $target == '' || $target =~ $target_pattern ]] || fail "invalid target name: $target"
read_config
deploy_command="vendor/bin/deploy${target:+ --target $target}"

echo 'Fetching origin …'
git fetch --tags --force origin
origin_refs=$(git ls-remote --heads --tags origin)
resolve_ref "$ref"

echo "Reading the live commit from $host …"
live_output=$(run_remote remote_inspect "$path" ${sync_patterns[@]+"${sync_patterns[@]}"}) \
  || fail "checking the server $host failed"
live_commit=$(sed -n 's/^deploy-commit=//p' <<< "$live_output" | tail -n 1)
live_branch=$(sed -n 's/^deploy-branch=//p' <<< "$live_output" | tail -n 1)
live_changes=$(sed -n 's/^deploy-sync=/  /p' <<< "$live_output")
[[ $live_commit =~ ^[0-9a-f]{40}$ ]] || fail "could not read the live commit on $host"

# Live changes, or a live commit that an interrupted sync left on the server only, go into the defaultRef branch first
sync=0
if [[ ${#sync_patterns[@]} != 0 ]] && { [[ $live_changes != '' ]] || ! on_origin "$live_commit"; }; then
  [[ $target_branch == "$default_ref" ]] \
    || fail "the server has live changes that are not in Git yet; deploy $default_ref first to sync them"
  sync=1
fi

echo
if [[ $target != '' ]]; then
  echo "Target:  $target ($host:$path)"
else
  echo "Server:  $host:$path"
fi
echo "Live:    $(describe "$live_commit")${live_branch:+ on branch $live_branch}"
echo "Deploy:  $(describe "$target_commit") ← $ref_label${target_branch:+ (branch, fast-forward)}"
if [[ $sync == 1 ]]; then
  if [[ $live_changes != '' ]]; then
    count=$(wc -l <<< "$live_changes" | tr -d ' ')
    echo "Live changes, committed on the server and added on top of $default_ref first ($count):"
    printf '%s\n' "$live_changes"
  else
    echo "The live commit is not on origin: it is added on top of $default_ref first."
  fi
fi
show_changes "$live_commit" "$target_commit"
echo

if [[ $assume_yes != 1 ]]; then
  [[ -t 0 ]] || fail 'no terminal to confirm; use --yes'
  if [[ $confirm == name ]]; then
    read -r -p "Deploy to $target? Type the target name to confirm: " answer || answer=''
    [[ $answer == "$target" ]] || fail 'cancelled'
  else
    read -r -p "Deploy${target:+ to $target}? [y/N] " answer || answer=''
    case $answer in
      y | Y | yes | Yes) ;;
      *) fail 'cancelled' ;;
    esac
  fi
fi

user_name=$(git config user.name || true)
user_email=$(git config user.email || true)
user_name=$(printf '%s' "${user_name:-${USER:-unknown}}" | tr -d '[:cntrl:]')
user_email=$(printf '%s' "$user_email" | tr -d '[:cntrl:]')
user="$user_name${user_email:+ <$user_email>}"

synced_commit=''
previous_commit=$live_commit
if [[ $sync == 1 ]]; then
  if [[ $live_changes != '' ]]; then
    echo "Committing the live changes on $host …"
    sync_output=$(run_remote remote_sync "$path" "$live_commit" "$user_name" "${user_email:-unknown}" \
      "${sync_patterns[@]}") || fail "committing the live changes on $host failed; nothing deployed"
    live_commit=$(sed -n 's/^deploy-commit=//p' <<< "$sync_output" | tail -n 1)
    [[ $live_commit =~ ^[0-9a-f]{40}$ ]] || fail "could not read the live commit on $host"
  fi
  echo "Fetching the live commit from $host …"
  fetch_live "$live_commit"
  synced_target=$(add_live "$target_commit" "$live_commit")
  if [[ $synced_target != "$target_commit" ]]; then
    echo "Pushing the live changes to $default_ref on origin …"
    git push --quiet origin "$synced_target:refs/heads/$default_ref" \
      || fail "pushing to origin failed; nothing deployed, deploy again (the live changes are committed on $host)"
    target_commit=$synced_target
  fi
  # The live commit is no ancestor of a commit created on top of the branch: the server branch moves to it
  if ! git merge-base --is-ancestor "$live_commit" "$target_commit"; then
    synced_commit=$live_commit
  fi
  git update-ref -d "$live_ref"
fi

rollback=$(rollback_hint "$live_commit" "$target_commit")
run_remote remote_deploy "$path" "$live_commit" "$target_commit" "$target_branch" "$synced_commit" "$ref_label" \
  "$user" "${#clear_patterns[@]}" ${clear_patterns[@]+"${clear_patterns[@]}"} \
  ${after_commands[@]+"${after_commands[@]}"} \
  || fail "deployment failed; the server log is $path/$log_file${rollback:+, roll back: $rollback}"

echo
echo "Live:     $(describe "$target_commit") ← $ref_label"
echo "Previous: $(describe "$previous_commit")"
[[ $rollback == '' ]] || echo "Roll back: $rollback"
